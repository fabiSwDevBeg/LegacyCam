<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fabiswdevbeg.legacycamd</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/LegacyCam.app/LegacyCam</string>
        <string>--daemon</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>UserName</key>
    <string>mobile</string>

    <key>WorkingDirectory</key>
    <string>/var/mobile</string>

    <key>StandardOutPath</key>
    <string>/var/mobile/Library/Logs/LegacyCam/legacycamd.log</string>

    <key>StandardErrorPath</key>
    <string>/var/mobile/Library/Logs/LegacyCam/legacycamd.err</string>
</dict>
</plist>
