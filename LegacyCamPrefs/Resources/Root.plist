<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>LegacyCam</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>footerText</key>
            <string>When disabled, LegacyCam keeps the HTTP daemon online but stops camera capture and the MJPEG stream.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.fabiswdevbeg.legacycam</string>
            <key>key</key>
            <string>CameraEnabled</string>
            <key>label</key>
            <string>Camera Enabled</string>
            <key>PostNotification</key>
            <string>com.fabiswdevbeg.legacycam/preferenceschanged</string>
        </dict>
    </array>
</dict>
</plist>
